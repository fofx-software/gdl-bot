# Required secrets. Store these in Secret Manager for Cloud Run; never commit
# populated values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
TELEGRAM_BOT_TOKEN=

# Generate a random value used to verify Telegram's
# X-Telegram-Bot-Api-Secret-Token webhook header.
TELEGRAM_WEBHOOK_SECRET=

# Cloud Run supplies PORT automatically; this default is useful locally.
PORT=8080
